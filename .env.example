# API server
DEBUG=true

# Database: leave unset to use SQLite under backend/data/db.sqlite3.
# For PostgreSQL + SQLAlchemy (e.g. pgvector): use psycopg3 driver, e.g.
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/insta_post_builder
# DATABASE_URL=

# Agent / LLM
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
TAVILY_API_KEY=
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=dall-e-3

# Stock photos/video (https://www.pexels.com/api/)
PEXELS_API_KEY=

USAGE_ANTHROPIC_INPUT_PER_MTOK_USD=3
USAGE_ANTHROPIC_OUTPUT_PER_MTOK_USD=15
USAGE_OPENAI_IMAGE_PER_CALL_USD=0.04
USAGE_TAVILY_PER_SEARCH_USD=0.008
# Set >0 if you allocate cost per Pexels API call internally
USAGE_PEXELS_PER_REQUEST_USD=0
